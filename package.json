{
  "name": "grain-print-app",
  "version": "1.0.16",
  "description": "A Self Print For Distributer",
  "main": "src/main.js",
  "grainRuntimeMode": "production",
  "scripts": {
    "start": "concurrently \"npm run dev:vue\" \"npm run dev:electron\"",
    "dev:vue": "cd vue && vite --mode development",
    "dev:electron": "node scripts/start-electron-dev.cjs",
    "build:vue": "cd vue && vite build --mode production",
    "build:vue:test": "cd vue && vite build --mode test",
    "test:security": "node scripts/security-smoke.js",
    "test:print-contract": "node scripts/print-contract-smoke.js",
    "test:slice0": "node scripts/slice0-architecture-smoke.js",
    "test:slice1": "node scripts/slice1-readonly-smoke.js",
    "test:slice3": "node scripts/slice3-write-smoke.js",
    "test:product-shell": "node scripts/product-shell-smoke.js",
    "test:p2-p3": "node scripts/p2-p3-productization-smoke.js",
    "test:p4": "node scripts/p4-product-experience-smoke.mjs",
    "test:production-api": "node scripts/production-api-smoke.js",
    "test:order-write": "node scripts/order-write-gateway-smoke.js",
    "test:customer-history-print": "node vue/src/modules/customer/presentation/customerHistoryPrint.test.mjs",
    "test:customer-center-modules": "node vue/src/modules/customer/presentation/customerCenterModules.test.mjs",
    "test:sales-analysis": "node scripts/sales-analysis-gateway-smoke.js && node vue/src/modules/salesAnalysis/presentation/salesAnalysisPresentation.test.mjs",
    "test:prediction-policy-ui": "node scripts/prediction-policy-ui-smoke.mjs",
    "generate:prediction-policy-fixture": "node scripts/generate-prediction-policy-fixture.mjs",
    "test:phase1": "npm run test:security && npm run test:print-contract",
    "test:phase2-slice0": "npm run test:slice0 && npm run test:phase1 && npm run build:vue",
    "test:phase2-slice1": "npm run test:slice0 && npm run test:slice1 && npm run test:phase1 && npm run build:vue",
    "test:phase2-slice3": "npm run test:slice0 && npm run test:slice3 && npm run test:phase1 && npm run build:vue",
    "dist": "npm run build:vue && electron-builder",
    "dist:mac": "npm run build:vue && GRAIN_BUILD_FLAVOR=production electron-builder --mac --config.extraMetadata.grainRuntimeMode=production",
    "dist:mac:test": "npm run build:vue:test && GRAIN_BUILD_FLAVOR=test electron-builder --mac --config.appId=club.grainservice.www.dev --config.productName=GrainPrint-Test --config.directories.output=release-test --config.extraMetadata.grainRuntimeMode=test",
    "dist:win": "npm run build:vue && electron-builder --win"
  },
  "build": {
    "publish": null,
    "appId": "club.grainservice.www",
    "productName": "GrainPrint",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.js",
    "files": [
      "dist/**/*",
      "src/**/*",
      "!src/main-bf.js",
      "!src/**/__pycache__/**",
      "!src/**/*.pyc",
      "!src/wechat/ui-automation/mac/artifacts/**",
      "!src/wechat/reader-runtime/python-win/**",
      "!src/wechat/image-tools/windows/**",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": false,
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "src/wechat/reader-runtime/python-win",
          "to": "wechat-reader-runtime/python-win"
        },
        {
          "from": "src/wechat/reader-runtime/product",
          "to": "wechat-reader-runtime/product",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        },
        {
          "from": "src/wechat/reader-runtime/tools/scquery.exe",
          "to": "wechat-reader-runtime/tools/scquery.exe"
        },
        {
          "from": "src/wechat/image-tools/windows",
          "to": "wechat-image-tools"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    },
    "mac": {
      "identity": null,
      "category": "public.app-category.productivity",
      "icon": "vue/src/assets/icons.icns",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "用于与微信协同排列窗口并读取当前微信会话。",
        "NSAccessibilityUsageDescription": "用于排列微信和订单工作台窗口，并同步当前微信会话。",
        "NSScreenCaptureUsageDescription": "用于读取微信会话头像和识别图片订单。"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  },
  "author": "Li Pei Yi",
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "electron": "^19.1.9",
    "electron-builder": "^23.6.0",
    "electron-devtools-installer": "^4.0.0",
    "rollup": "^2.79.1",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@nut-tree/nut-js": "^3.1.2",
    "admin-lte": "^4.0.0-beta2",
    "asynckit": "^0.4.0",
    "axios": "^1.7.9",
    "bootstrap": "^5.3.3",
    "bootstrap-vue-3": "^0.5.1",
    "combined-stream": "^1.0.8",
    "delayed-stream": "^1.0.0",
    "es-set-tostringtag": "^2.1.0",
    "ffmpeg-static": "^5.3.0",
    "form-data": "^4.0.0",
    "hasown": "^2.0.2",
    "jquery": "^3.7.1",
    "mime-db": "^1.52.0",
    "mime-types": "^2.1.12",
    "node-record-lpcm16": "^1.0.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuex": "^4.0.2"
  }
}
