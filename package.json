{
  "name": "grain-print-app",
  "version": "1.0.0",
  "description": "A Self Print For Distributer",
  "main": "src/main.js",
  "scripts": {
    "start": "concurrently \"npm run dev:vue\" \"npm run dev:electron\"",
    "dev:vue": "cd vue && vite",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "build:vue": "cd vue && vite build",
    "dist": "npm run build:vue && electron-builder",
    "dist:mac": "npm run build:vue && electron-builder --mac",
    "dist:win": "npm run build:vue && electron-builder --win"
  },
  "build": {
    "publish": null,
    "appId": "club.grainservice.www",
    "productName": "GrainPrint",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/**/*",
      "package.json",
      "node_modules/**/*",
      "config/**/*"
    ],
    "asar": false,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["zh_CN", "en_US"],
      "language": "2052"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "vue/src/assets/icons.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  },
  "author": "Li Pei Yi",
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "electron": "^19.1.9",
    "electron-builder": "^23.6.0",
    "electron-devtools-installer": "^4.0.0",
    "rollup": "^2.79.1",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@nut-tree/nut-js": "^3.1.2",
    "admin-lte": "^4.0.0-beta2",
    "asynckit": "^0.4.0",
    "axios": "^1.7.9",
    "bootstrap": "^5.3.3",
    "bootstrap-vue-3": "^0.5.1",
    "combined-stream": "^1.0.8",
    "delayed-stream": "^1.0.0",
    "es-set-tostringtag": "^2.1.0",
    "form-data": "^4.0.0",
    "hasown": "^2.0.2",
    "jquery": "^3.7.1",
    "mime-db": "^1.52.0",
    "mime-types": "^2.1.12",
    "node-record-lpcm16": "^1.0.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuex": "^4.0.2"
  }
}
